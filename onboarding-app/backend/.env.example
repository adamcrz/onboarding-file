# Copy to backend/.env and fill in. Never commit the real .env — it is
# gitignored for a reason: it holds the database credentials and the key that
# signs every session token.

PORT=5000
# development | production. "production" turns on HSTS, secure cookies, the
# strict rate limits, and the startup check below.
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/complianceos
# Hosted: the MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/complianceos

# ─── Uploaded files ───────────────────────────────────────────────────────────
# Signed contracts and supporting documents are written to disk, not into
# MongoDB. Leave blank locally (they go to backend/uploads). On a hosted
# platform set this to a mounted persistent disk, or every deploy wipes them.
UPLOADS_DIR=

# Permanent archive: a second copy of every uploaded file, written into the
# OneDrive-synced SharePoint library. This is what lets approved, downloaded
# contracts be released from the database (npm run purge-files) without ever
# losing them, and it keeps the documents somewhere the firm already governs.
# The path contains your own user name, so each machine sets its own. Example:
#   ARCHIVE_DIR=C:\Users\you\OneDrive - Tramondo Investment Partners AG\Risk Management Tasks Monthly - Documents\General\Project Onboarding Tool\Documents
# Leave blank to turn archiving off.
ARCHIVE_DIR=

# How often a copy that can see the archive checks the database for files it
# does not have yet, in minutes.
#
# This is what carries documents created on the hosted instance into SharePoint.
# That instance runs in a container with no OneDrive, so it has no archive to
# write to — its files live in the database only. Whichever copy *can* see the
# folder brings them across while it is open. Only runs where ARCHIVE_DIR is set.
ARCHIVE_SYNC_MINUTES=10

# ─── Session signing key ──────────────────────────────────────────────────────
# At least 32 characters of randomness. In production the server refuses to
# start if this is missing, too short, or still the placeholder below.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-to-a-strong-random-secret

# ─── Who may call the API from a browser ──────────────────────────────────────
# Comma-separated list of origins. Leave blank in development (localhost is
# allowed automatically). In production set it to the app's own public URL,
# e.g. https://onboarding.yourcompany.com
ALLOWED_ORIGINS=

# ─── Email ────────────────────────────────────────────────────────────────────
# Leave all EMAIL_* blank to use Ethereal (fake SMTP, preview link in console).
# For Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
#            EMAIL_USER=you@gmail.com, EMAIL_PASS=your-app-password
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="ComplianceOS" <noreply@complianceos.com>

# Base URL of the app — used to build verify/reset links in emails.
FRONTEND_URL=http://localhost:5000

# ─── Periodic sign-in check ───────────────────────────────────────────────────
# Every N days a sign-in also asks for a 6-digit code emailed to the account's
# address, re-proving the person still controls that mailbox. Between those
# checks the sign-in is unchanged. Blank or 0 turns it off.
#
# It refuses to arm unless EMAIL_HOST/USER/PASS above are set for real mail.
# Without them the app writes to a fake inbox whose preview link only appears
# in the server console, so demanding a code would lock every account out at
# once — including the ones needed to turn it back off. The server prints
# which state it is in at startup.
LOGIN_REVERIFY_DAYS=

# Public self-registration. Off by default: staff accounts come from
# scripts/createAccount.js and client accounts from the Contract Builder's
# invitation, so an open sign-up only creates accounts nobody asked for.
ALLOW_PUBLIC_REGISTRATION=false

# ─── Optional switches ────────────────────────────────────────────────────────
# Automatic signature/checkbox checking on upload. Currently off in favour of
# manual Compliance review; the detection code is intact behind this flag.
DOCUMENT_AUTO_VERIFY=false

# Gates scripts/resetDatabase.js. Must never be true in production — the
# server refuses to start if it is.
ALLOW_DATABASE_RESET=false
